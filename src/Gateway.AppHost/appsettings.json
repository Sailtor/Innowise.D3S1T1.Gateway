{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MetricsDb": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "GraphQL": {
    "AllowIntrospection": false
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
